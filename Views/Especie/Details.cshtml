@model Veterinaria.Models.Especie

@{
    ViewData["Title"] = "Detalles de la Especie";
}

<h1>Detalles de la Especie</h1>

<hr />

<div>
    <dl class="row">

        <dt class="col-sm-3">
            Nombre
        </dt>

        <dd class="col-sm-9">
            @Model.Nombre
        </dd>

        <dt class="col-sm-3">
            Activo
        </dt>

        <dd class="col-sm-9">
            @(Model.Activo ? "Sí" : "No")
        </dd>

    </dl>
</div>

<div>
    <a asp-action="Edit" asp-route-id="@Model.IdEspecie" class="btn btn-primary">
        Editar
    </a>

    <a asp-action="Index" class="btn btn-secondary">
        Volver
    </a>
</div>

@model IEnumerable<Veterinaria.Models.Especie>

@{
    ViewData["Title"] = "Especies";

    int paginaActual = ViewBag.PaginaActual ?? 1;
    int totalPaginas = ViewBag.TotalPaginas ?? 0;
    int totalRegistros = ViewBag.TotalRegistros ?? 0;
}

<h1>Especies</h1>

<hr />

@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success">
        @TempData["Mensaje"]
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        @TempData["Error"]
    </div>
}

<p>
    <a asp-action="Create" class="btn btn-primary">
        Nueva especie
    </a>
</p>

<div class="table-responsive">
    <table class="table table-striped table-bordered align-middle">
        <thead class="table-dark">
            <tr>
                <th>Nombre</th>
                <th>Activo</th>
                <th>Acciones</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var especie in Model)
            {
                <tr>
                    <td>@especie.Nombre</td>

                    <td>
                        @if (especie.Activo)
                        {
                            <span class="badge bg-success">
                                Sí
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">
                                No
                            </span>
                        }
                    </td>

                    <td>
                        <div class="d-flex gap-1 flex-wrap">

                            <a asp-action="Details"
                               asp-route-id="@especie.IdEspecie"
                               class="btn btn-info btn-sm">
                                Ver
                            </a>

                            <a asp-action="Edit"
                               asp-route-id="@especie.IdEspecie"
                               class="btn btn-warning btn-sm">
                                Editar
                            </a>

                            <a asp-action="Delete"
                               asp-route-id="@especie.IdEspecie"
                               class="btn btn-danger btn-sm">
                                Eliminar
                            </a>
                        </div>
                    </td>
                </tr>
            }

            @if (!Model.Any())
            {
                <tr>
                    <td colspan="3"
                        class="text-center text-muted">
                        No hay especies registradas.
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<!-- PAGINACIÓN -->
<div class="d-flex justify-content-between
            align-items-center flex-wrap gap-2 mt-3">

    <span class="text-muted">
        Total de especies: @totalRegistros
    </span>

    <div class="d-flex align-items-center gap-2">

        @if (paginaActual > 1)
        {
            <a asp-action="Index"
               asp-route-pagina="@(paginaActual - 1)"
               class="btn btn-outline-primary btn-sm">
                Anterior
            </a>
        }
        else
        {
            <button class="btn btn-outline-secondary btn-sm"
                    disabled>
                Anterior
            </button>
        }

        <span>
            Página @(totalPaginas == 0 ? 0 : paginaActual)
            de @totalPaginas
        </span>

        @if (paginaActual < totalPaginas)
        {
            <a asp-action="Index"
               asp-route-pagina="@(paginaActual + 1)"
               class="btn btn-outline-primary btn-sm">
                Siguiente
            </a>
        }
        else
        {
            <button class="btn btn-outline-secondary btn-sm"
                    disabled>
                Siguiente
            </button>
        }
    </div>
</div>

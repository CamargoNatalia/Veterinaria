
@model IEnumerable<Veterinaria.Models.Veterinario>

@{
    ViewData["Title"] = "Veterinarios";

    int paginaActual = ViewBag.PaginaActual ?? 1;
    int totalPaginas = ViewBag.TotalPaginas ?? 0;
    int totalRegistros = ViewBag.TotalRegistros ?? 0;

    bool esAdministrador = User.IsInRole("Administrador");
}

<h1>Gestión de Veterinarios</h1>

<hr />

@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success">
        @TempData["Mensaje"]
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        @TempData["Error"]
    </div>
}

@if (esAdministrador)
{
    <p>
        <a asp-action="Create" class="btn btn-primary">
            Nuevo Veterinario
        </a>
    </p>
}

<div class="table-responsive">
    <table class="table table-striped table-bordered align-middle">

        <thead class="table-dark">
            <tr>
                <th>Nombre completo</th>
                <th>Matrícula</th>
                <th>Especialidad</th>
                <th>Teléfono</th>
                <th>Correo</th>
                <th>Estado</th>
                <th>Acciones</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var veterinario in Model)
            {
                <tr>
                    <td>
                        @(veterinario.Usuario?.Nombre ?? "Sin usuario")
                    </td>

                    <td>@veterinario.Matricula</td>
                    <td>@veterinario.Especialidad</td>
                    <td>@veterinario.Telefono</td>

                    <td>
                        @(veterinario.Usuario?.Email ?? "-")
                    </td>

                    <td>
                        @if (veterinario.Usuario?.Activo == true)
                        {
                            <span class="badge bg-success">
                                Activo
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">
                                Inactivo
                            </span>
                        }
                    </td>

                    <td>
                        <div class="d-flex gap-1 flex-wrap">

                            <a asp-action="Details"
                               asp-route-id="@veterinario.IdVeterinario"
                               class="btn btn-info btn-sm">
                                Ver
                            </a>

                            @if (esAdministrador)
                            {
                                <a asp-action="Edit"
                                   asp-route-id="@veterinario.IdVeterinario"
                                   class="btn btn-warning btn-sm">
                                    Editar
                                </a>

                                @if (veterinario.Usuario?.Activo == true)
                                {
                                    <a asp-action="Delete"
                                       asp-route-id="@veterinario.IdVeterinario"
                                       class="btn btn-danger btn-sm">
                                        Desactivar
                                    </a>
                                }
                            }
                        </div>
                    </td>
                </tr>
            }

            @if (!Model.Any())
            {
                <tr>
                    <td colspan="7"
                        class="text-center text-muted">
                        No hay veterinarios registrados.
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<!-- Paginación -->
<div class="d-flex justify-content-between
            align-items-center flex-wrap gap-2 mt-3">

    <span class="text-muted">
        Total de veterinarios: @totalRegistros
    </span>

    <div class="d-flex align-items-center gap-2">

        @if (paginaActual > 1)
        {
            <a asp-action="Index"
               asp-route-pagina="@(paginaActual - 1)"
               class="btn btn-outline-primary btn-sm">
                Anterior
            </a>
        }
        else
        {
            <button class="btn btn-outline-secondary btn-sm"
                    disabled>
                Anterior
            </button>
        }

        <span>
            Página @(totalPaginas == 0 ? 0 : paginaActual)
            de @totalPaginas
        </span>

        @if (paginaActual < totalPaginas)
        {
            <a asp-action="Index"
               asp-route-pagina="@(paginaActual + 1)"
               class="btn btn-outline-primary btn-sm">
                Siguiente
            </a>
        }
        else
        {
            <button class="btn btn-outline-secondary btn-sm"
                    disabled>
                Siguiente
            </button>
        }
    </div>
</div>

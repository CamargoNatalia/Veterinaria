@model Veterinaria.Models.Veterinario

@{
    ViewData["Title"] = "Editar Veterinario";
}

<h1>Editar Veterinario</h1>

<hr />

<div class="row">
    <div class="col-md-7">

        <form asp-action="Edit" asp-route-id="@Model.IdVeterinario" method="post">

            @Html.AntiForgeryToken()

            <input type="hidden" asp-for="IdVeterinario" />

            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <!-- Datos del usuario asociado -->
            <div class="mb-3">
                <label class="form-label">
                    Veterinario
                </label>

                <input type="text" value="@Model.Usuario?.Nombre" class="form-control" readonly />
            </div>

            <div class="mb-3">
                <label class="form-label">
                    Correo electrónico
                </label>

                <input type="email" value="@Model.Usuario?.Email" class="form-control" readonly />
            </div>

            <!-- Matrícula profesional -->
            <div class="mb-3">
                <label asp-for="Matricula" class="form-label">
                    Matrícula
                </label>

                <input asp-for="Matricula" class="form-control" />

                <span asp-validation-for="Matricula" class="text-danger"></span>
            </div>

            <!-- Especialidad -->
            <div class="mb-3">
                <label asp-for="Especialidad" class="form-label"></label>

                <input asp-for="Especialidad" class="form-control" />

                <span asp-validation-for="Especialidad" class="text-danger"></span>
            </div>

            <!-- Teléfono -->
            <div class="mb-3">
                <label asp-for="Telefono" class="form-label">
                    Teléfono
                </label>

                <input asp-for="Telefono" class="form-control" />

                <span asp-validation-for="Telefono" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary">
                Guardar Cambios
            </button>

            <a asp-action="Index" class="btn btn-secondary">
                Volver
            </a>

        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
@model Veterinaria.Models.Veterinario

@{
    ViewData["Title"] = "Nuevo Veterinario";
}

<h1>Nuevo Veterinario</h1>

<hr />

<div class="row">
    <div class="col-md-7">

        <form asp-action="Create" method="post">

            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <!-- Usuario asociado -->
            <div class="mb-3">
                <label asp-for="IdUsuario" class="form-label">
                    Usuario
                </label>

                <select asp-for="IdUsuario" asp-items="ViewBag.Usuarios" class="form-select">

                    <option value="0">
                        -- Seleccione un usuario veterinario --
                    </option>
                </select>

                <span asp-validation-for="IdUsuario" class="text-danger"></span>
            </div>

            <!-- Matrícula profesional -->
            <div class="mb-3">
                <label asp-for="Matricula" class="form-label">
                    Matrícula
                </label>

                <input asp-for="Matricula" class="form-control" />

                <span asp-validation-for="Matricula" class="text-danger"></span>
            </div>

            <!-- Especialidad -->
            <div class="mb-3">
                <label asp-for="Especialidad" class="form-label"></label>

                <input asp-for="Especialidad" class="form-control" />

                <span asp-validation-for="Especialidad" class="text-danger"></span>
            </div>

            <!-- Teléfono -->
            <div class="mb-3">
                <label asp-for="Telefono" class="form-label">
                    Teléfono
                </label>

                <input asp-for="Telefono" class="form-control" />

                <span asp-validation-for="Telefono" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary">
                Guardar Veterinario
            </button>

            <a asp-action="Index" class="btn btn-secondary">
                Volver
            </a>

        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
@model Veterinaria.Models.Veterinario

@{
    ViewData["Title"] = "Detalles del Veterinario";
}

<h1>Detalles del Veterinario</h1>

<hr />

<div class="card mb-4">

    <div class="card-header">
        <h5 class="mb-0">
            @(Model.Usuario?.Nombre ?? "Sin usuario asociado")
        </h5>
    </div>

    <div class="card-body">
        <dl class="row">

            <dt class="col-sm-3">Nombre completo</dt>
            <dd class="col-sm-9">
                @(Model.Usuario?.Nombre ?? "-")
            </dd>

            <dt class="col-sm-3">Correo electrónico</dt>
            <dd class="col-sm-9">
                @(Model.Usuario?.Email ?? "-")
            </dd>

            <dt class="col-sm-3">Matrícula</dt>
            <dd class="col-sm-9">
                @Model.Matricula
            </dd>

            <dt class="col-sm-3">Especialidad</dt>
            <dd class="col-sm-9">
                @Model.Especialidad
            </dd>

            <dt class="col-sm-3">Teléfono</dt>
            <dd class="col-sm-9">
                @Model.Telefono
            </dd>

            <dt class="col-sm-3">Estado</dt>
            <dd class="col-sm-9">
                @if (Model.Usuario?.Activo == true)
                {
                    <span class="badge bg-success">
                        Activo
                    </span>
                }
                else
                {
                    <span class="badge bg-secondary">
                        Inactivo
                    </span>
                }
            </dd>

        </dl>
    </div>
</div>

@if (User.IsInRole("Administrador"))
{
    <a asp-action="Edit" asp-route-id="@Model.IdVeterinario" class="btn btn-warning">
        Editar
    </a>
}

<a asp-action="Index" class="btn btn-secondary">
    Volver
</a>
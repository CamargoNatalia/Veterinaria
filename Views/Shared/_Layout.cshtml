<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Veterinaria </title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/PruebaVete .styles.css" asp-append-version="true" />
</head>

<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">

                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">
                    Veterinaria
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse"
                        aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">

                    <ul class="navbar-nav flex-grow-1">

                        @if (User.IsInRole("Administrador") || User.IsInRole("Empleado"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="Cliente" asp-action="Index">
                                    Clientes
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="Mascota" asp-action="Index">
                                    Mascotas
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="Especie" asp-action="Index">
                                    Especies
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="Raza" asp-action="Index">
                                    Razas
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="Turno" asp-action="Index">
                                    Turnos
                                </a>
                            </li>

                            
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Consulta" asp-action="Index">
                                    Consultas
                                </a>
                            </li>

                        }

                        @if (User.IsInRole("Administrador"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="Usuario" asp-action="Index">
                                    Usuarios
                                </a>
                            </li>
                        }

                    </ul>

                    <ul class="navbar-nav align-items-center">

                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            var avatarUsuario = User.FindFirst("Avatar")?.Value;
                            var rolUsuario = User.FindFirst(
                                System.Security.Claims.ClaimTypes.Role
                            )?.Value;

                            <li class="nav-item">
                                <div class="nav-link text-dark d-flex align-items-center gap-2">
                                    <li class="nav-item">
                                        <a class="nav-link text-dark" asp-controller="Usuario" asp-action="Perfil">
                                            Mi Perfil
                                        </a>
                                    </li>
                                    @if (!string.IsNullOrWhiteSpace(avatarUsuario))
                                    {
                                        
                                       

                                        <img src="@avatarUsuario" alt="Avatar" class="rounded-circle border"
                                             style="width:36px;height:36px;object-fit:cover;" />
                                    }
                                    else
                                    {
                                        <div class="rounded-circle bg-secondary text-white d-flex align-items-center justify-content-center"
                                             style="width:36px;height:36px;font-weight:bold;">
                                            @(User.Identity?.Name?.Substring(0, 1).ToUpper() ?? "U")
                                        </div>
                                    }

                                    <span>
                                        Hola, @User.Identity?.Name (@rolUsuario)
                                    </span>

                                </div>
                            </li>

                            <li class="nav-item">
                                <form asp-controller="Usuario" asp-action="Logout" method="post">
                                    @Html.AntiForgeryToken()

                                    <button type="submit" class="btn btn-link nav-link text-dark">
                                        Cerrar sesión
                                    </button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Usuario" asp-action="Login">
                                    Iniciar sesión
                                </a>
                            </li>
                        }

                    </ul>

                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - Veterinaria -
            <a asp-area="" asp-controller="Home" asp-action="Privacy">
                Privacy
            </a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>

</html>

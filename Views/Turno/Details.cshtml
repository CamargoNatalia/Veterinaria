@model Veterinaria.Models.Turno

@{
    ViewData["Title"] = "Detalles del Turno";
}

<h1>Detalles del Turno</h1>

<hr />

<dl class="row">

    <dt class="col-sm-3">
        Fecha y Hora
    </dt>
    <dd class="col-sm-9">
        @Model.FechaHora.ToString("dd/MM/yyyy HH:mm")
    </dd>

    <dt class="col-sm-3">
        Mascota
    </dt>
    <dd class="col-sm-9">
        @Model.Mascota?.Nombre
    </dd>

    <dt class="col-sm-3">
        Usuario
    </dt>
    <dd class="col-sm-9">
        @Model.Usuario?.Nombre
    </dd>

    <dt class="col-sm-3">
        Estado
    </dt>
    <dd class="col-sm-9">
        @Model.Estado
    </dd>

    <dt class="col-sm-3">
        Motivo
    </dt>
    <dd class="col-sm-9">
        @Model.Motivo
    </dd>

    <dt class="col-sm-3">
        Observaciones
    </dt>
    <dd class="col-sm-9">
        @Model.Observaciones
    </dd>

</dl>

<div>
    <a asp-action="Edit" asp-route-id="@Model.IdTurno" class="btn btn-primary">
        Editar
    </a>

    <a asp-action="Index" class="btn btn-secondary">
        Volver
    </a>
</div>
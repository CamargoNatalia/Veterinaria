@model Veterinaria.Models.Turno

@{
    ViewData["Title"] = "Eliminar Turno";
}

<h1>Eliminar Turno</h1>

<h3>¿Está seguro de que desea eliminar este turno?</h3>

<hr />

<dl class="row">

    <dt class="col-sm-3">
        Fecha y Hora
    </dt>
    <dd class="col-sm-9">
        @Model.FechaHora.ToString("dd/MM/yyyy HH:mm")
    </dd>

    <dt class="col-sm-3">
        Mascota
    </dt>
    <dd class="col-sm-9">
        @Model.Mascota?.Nombre
    </dd>

    <dt class="col-sm-3">
        Usuario
    </dt>
    <dd class="col-sm-9">
        @Model.Usuario?.Nombre
    </dd>

    <dt class="col-sm-3">
        Estado
    </dt>
    <dd class="col-sm-9">
        @Model.Estado
    </dd>

    <dt class="col-sm-3">
        Motivo
    </dt>
    <dd class="col-sm-9">
        @Model.Motivo
    </dd>

</dl>

<form asp-action="Delete">

    <input type="hidden" asp-for="IdTurno" />

    <input type="submit"
           value="Eliminar"
           class="btn btn-danger" />

    <a asp-action="Index" class="btn btn-secondary">
        Cancelar
    </a>

</form>
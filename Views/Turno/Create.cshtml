
@model Veterinaria.Models.Turno

@{
    ViewData["Title"] = "Nuevo Turno";
}

<h1>Nuevo Turno</h1>
<hr />

<div class="row">
    <div class="col-md-6">

        <form asp-action="Create" method="post" id="formTurno">

            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="FechaHora" class="form-label"></label>

                <input asp-for="FechaHora"
                       class="form-control"
                       type="datetime-local"
                       asp-format="{0:yyyy-MM-ddTHH:mm}" />

                <span asp-validation-for="FechaHora"
                      class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Motivo" class="form-label"></label>

                <textarea asp-for="Motivo"
                          class="form-control"></textarea>

                <span asp-validation-for="Motivo"
                      class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label class="form-label">Estado</label>

                <input type="text"
                       value="Pendiente"
                       class="form-control"
                       readonly />

                <div class="form-text">
                    El turno se registrará automáticamente como pendiente.
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="Observaciones"
                       class="form-label"></label>

                <textarea asp-for="Observaciones"
                          class="form-control"></textarea>

                <span asp-validation-for="Observaciones"
                      class="text-danger"></span>
            </div>

            <!-- BÚSQUEDA AJAX DE MASCOTA -->
            <div class="mb-3">
                <label for="buscarMascota" class="form-label">
                    Mascota
                </label>

                <input id="buscarMascota"
                       type="text"
                       class="form-control"
                       placeholder="Buscar por mascota o propietario..."
                       autocomplete="off"
                       value="@ViewBag.MascotaSeleccionada" />

                <input asp-for="IdMascota" type="hidden" />

                <div id="resultadosMascotas"
                     class="list-group mt-1"></div>

                <div id="avisoMascota" class="form-text">
                    Escribí al menos 2 caracteres y seleccioná una mascota.
                </div>

                <span asp-validation-for="IdMascota"
                      class="text-danger"></span>
            </div>

            <div class="mt-3">
                <button type="submit" class="btn btn-primary">
                    Crear Turno
                </button>

                <a asp-action="Index" class="btn btn-secondary">
                    Volver
                </a>
            </div>

        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const buscador = document.getElementById("buscarMascota");
            const idMascota = document.getElementById("IdMascota");
            const resultados = document.getElementById("resultadosMascotas");
            const aviso = document.getElementById("avisoMascota");

            let temporizador;
            let solicitudActual = 0;

            buscador.addEventListener("input", function () {

                const texto = buscador.value.trim();
                const numeroSolicitud = ++solicitudActual;

                clearTimeout(temporizador);

                idMascota.value = "";
                resultados.replaceChildren();

                aviso.textContent =
                    "Seleccioná una mascota de los resultados.";

                if (texto.length < 2) {
                    aviso.textContent = "Escribí al menos 2 caracteres.";
                    return;
                }

                temporizador = setTimeout(async function () {

                    try {
                        const url =
                            '@Url.Action("BuscarMascotas", "Turno")'
                            + "?termino=" + encodeURIComponent(texto);

                        const respuesta = await fetch(url, {
                            credentials: "same-origin"
                        });

                        if (!respuesta.ok)
                            throw new Error("Error de búsqueda");

                        const mascotas = await respuesta.json();

                        if (numeroSolicitud !== solicitudActual)
                            return;

                        resultados.replaceChildren();

                        if (mascotas.length === 0) {
                            aviso.textContent =
                                "No se encontraron mascotas activas.";
                            return;
                        }

                        aviso.textContent =
                            "Elegí una mascota de los resultados.";

                        mascotas.forEach(function (mascota) {

                            const descripcion =
                                mascota.nombre + " - " +
                                mascota.propietario + " - " +
                                mascota.especie + " - " +
                                mascota.raza;

                            const boton =
                                document.createElement("button");

                            boton.type = "button";
                            boton.className =
                                "list-group-item list-group-item-action";

                            boton.textContent = descripcion;

                            boton.addEventListener("click", function () {

                                ++solicitudActual;
                                clearTimeout(temporizador);

                                idMascota.value = mascota.idMascota;
                                buscador.value = descripcion;

                                resultados.replaceChildren();

                                aviso.textContent =
                                    "Mascota seleccionada correctamente.";
                            });

                            resultados.appendChild(boton);
                        });

                    } catch (error) {
                        if (numeroSolicitud === solicitudActual) {
                            resultados.replaceChildren();
                            aviso.textContent =
                                "No se pudo realizar la búsqueda.";
                        }
                    }

                }, 300);
            });

            document.getElementById("formTurno")
                .addEventListener("submit", function (e) {

                    if (!idMascota.value ||
                        Number(idMascota.value) <= 0) {

                        e.preventDefault();

                        aviso.textContent =
                            "Tenés que seleccionar una mascota de la lista.";

                        buscador.focus();
                    }
                });
        });
    </script>
}

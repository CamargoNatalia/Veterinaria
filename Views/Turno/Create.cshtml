@model Veterinaria.Models.Turno

@{
    ViewData["Title"] = "Nuevo Turno";
}

<h1>Nuevo Turno</h1>

<hr />

<div class="row">
    <div class="col-md-6">

        <form asp-action="Create" method="post">

            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <!-- Fecha y hora -->
            <div class="form-group mb-3">
                <label asp-for="FechaHora" class="control-label"></label>

                <input asp-for="FechaHora" class="form-control" type="datetime-local"
                       asp-format="{0:yyyy-MM-ddTHH:mm}" />

                <span asp-validation-for="FechaHora" class="text-danger"></span>
            </div>

            <!-- Motivo -->
            <div class="form-group mb-3">
                <label asp-for="Motivo" class="control-label"></label>

                <textarea asp-for="Motivo" class="form-control"></textarea>

                <span asp-validation-for="Motivo" class="text-danger"></span>
            </div>

            <!-- Estado inicial -->
            <div class="form-group mb-3">
                <label class="control-label">
                    Estado
                </label>

                <input type="text" value="Pendiente" class="form-control" readonly />

                <div class="form-text">
                    El turno se registrará automáticamente
                    como pendiente.
                </div>
            </div>

            <!-- Observaciones -->
            <div class="form-group mb-3">
                <label asp-for="Observaciones" class="control-label"></label>

                <textarea asp-for="Observaciones" class="form-control"></textarea>

                <span asp-validation-for="Observaciones" class="text-danger"></span>
            </div>

            <!-- Mascota -->
            <div class="form-group mb-3">
                <label asp-for="IdMascota" class="control-label">
                    Mascota
                </label>

                <select asp-for="IdMascota" class="form-select" asp-items="ViewBag.Mascotas">

                    <option value="">
                        Seleccione una mascota
                    </option>
                </select>

                <span asp-validation-for="IdMascota" class="text-danger"></span>
            </div>

            <!-- Acciones -->
            <div class="form-group mt-3">

                <button type="submit" class="btn btn-primary">
                    Crear Turno
                </button>

                <a asp-action="Index" class="btn btn-secondary">
                    Volver
                </a>

            </div>

        </form>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
@model IEnumerable<Veterinaria.Models.Turno>

@{
    ViewData["Title"] = "Turnos";
}

<h1>Gestión de Turnos</h1>

<hr />

@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success">
        @TempData["Mensaje"]
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        @TempData["Error"]
    </div>
}

<p>
    <a asp-action="Create" class="btn btn-primary">
        Nuevo Turno
    </a>
</p>

<div class="table-responsive">

    <table class="table table-striped table-bordered align-middle">

        <thead class="table-dark">
            <tr>
                <th>Fecha y Hora</th>
                <th>Mascota</th>
                <th>Usuario</th>
                <th>Estado</th>
                <th>Motivo</th>
                <th>Observaciones</th>
                <th>Acciones</th>
            </tr>
        </thead>

        <tbody>

            @foreach (var item in Model)
            {
                <tr>
                    <td>
                        @item.FechaHora.ToString("dd/MM/yyyy HH:mm")
                    </td>

                    <td>
                        @(item.Mascota?.Nombre ?? "-")
                    </td>

                    <td>
                        @(item.Usuario?.Nombre ?? "-")
                    </td>

                    <td>
                        @if (item.Estado == "Pendiente")
                        {
                            <span class="badge bg-warning text-dark">
                                Pendiente
                            </span>
                        }
                        else if (item.Estado == "Confirmado")
                        {
                            <span class="badge bg-primary">
                                Confirmado
                            </span>
                        }
                        else if (item.Estado == "Atendido")
                        {
                            <span class="badge bg-success">
                                Atendido
                            </span>
                        }
                        else if (item.Estado == "Cancelado")
                        {
                            <span class="badge bg-secondary">
                                Cancelado
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">
                                @item.Estado
                            </span>
                        }
                    </td>

                    <td>@item.Motivo</td>

                    <td>@item.Observaciones</td>

                    <td>
                        <div class="d-flex gap-1 flex-wrap">

                            <!-- Ver detalles -->
                            <a asp-action="Details" asp-route-id="@item.IdTurno" class="btn btn-info btn-sm">
                                Ver
                            </a>

                            <!-- Editar turnos no atendidos -->
                            @if (item.Estado != "Atendido")
                            {
                                <a asp-action="Edit" asp-route-id="@item.IdTurno" class="btn btn-warning btn-sm">
                                    Editar
                                </a>
                            }

                            <!-- Solo administración y empleados -->
                            @if ((User.IsInRole("Administrador") ||
                                  User.IsInRole("Empleado")) &&
                                  item.Estado != "Atendido")
                            {
                                <a asp-action="Delete" asp-route-id="@item.IdTurno" class="btn btn-danger btn-sm">
                                    Eliminar
                                </a>
                            }

                        </div>
                    </td>
                </tr>
            }

            @if (!Model.Any())
            {
                <tr>
                    <td colspan="7" class="text-center text-muted">
                        No hay turnos registrados.
                    </td>
                </tr>
            }

        </tbody>
    </table>

</div>
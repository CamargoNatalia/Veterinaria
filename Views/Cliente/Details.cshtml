@model Veterinaria.Models.Cliente

@{
    ViewData["Title"] = "Detalles del Cliente";

    bool puedeAdministrar =
        User.IsInRole("Administrador") ||
        User.IsInRole("Empleado");
}

<h1>Detalles del Cliente</h1>

<hr />

<div class="card mb-4">
    <div class="card-header">
        <h5 class="mb-0">
            Información del Propietario
        </h5>
    </div>

    <div class="card-body">
        <dl class="row">

            <dt class="col-sm-3">Nombre</dt>
            <dd class="col-sm-9">
                @Model.Nombre
            </dd>

            <dt class="col-sm-3">Apellido</dt>
            <dd class="col-sm-9">
                @Model.Apellido
            </dd>

            <dt class="col-sm-3">DNI</dt>
            <dd class="col-sm-9">
                @Model.Dni
            </dd>

            <dt class="col-sm-3">Teléfono</dt>
            <dd class="col-sm-9">
                @Model.Telefono
            </dd>

            <dt class="col-sm-3">Correo electrónico</dt>
            <dd class="col-sm-9">
                @Model.Correo
            </dd>

            <dt class="col-sm-3">Dirección</dt>
            <dd class="col-sm-9">
                @Model.Direccion
            </dd>

            <dt class="col-sm-3">Estado</dt>
            <dd class="col-sm-9">
                @if (Model.Activo)
                {
                    <span class="badge bg-success">
                        Activo
                    </span>
                }
                else
                {
                    <span class="badge bg-secondary">
                        Inactivo
                    </span>
                }
            </dd>

        </dl>
    </div>
</div>

<!-- Acciones -->
<div class="mb-4 d-flex gap-2">

    @if (puedeAdministrar)
    {
        <a asp-action="Edit" asp-route-id="@Model.IdCliente" class="btn btn-warning">
            Editar
        </a>
    }

    <a asp-action="Index" class="btn btn-secondary">
        Volver
    </a>

</div>
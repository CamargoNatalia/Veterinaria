
@model Veterinaria.Models.Usuario

@{
    ViewData["Title"] = "Editar Mi Perfil";
}

<h2>Editar Mi Perfil</h2>

<div class="row mt-3">
    <div class="col-md-6">
        <div class="card">

            <div class="card-header">
                <strong>Datos Personales</strong>
            </div>

            <div class="card-body">

                <form asp-controller="Usuario"
                      asp-action="EditarPerfil"
                      method="post">

                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly"
                         class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label for="nombre" class="form-label">Nombre</label>
                        <input type="text"
                               id="nombre"
                               name="nombre"
                               value="@Model.Nombre"
                               class="form-control"
                               maxlength="100"
                               required />
                        <span asp-validation-for="Nombre" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label for="email" class="form-label">Email</label>
                        <input type="email"
                               id="email"
                               name="email"
                               value="@Model.Email"
                               class="form-control"
                               maxlength="150"
                               required />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Rol</label>
                        <input type="text"
                               value="@Model.Rol"
                               class="form-control"
                               readonly />
                        <div class="form-text">
                            El rol no puede modificarse desde Mi Perfil.
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Estado</label>
                        <div>
                            @if (Model.Activo)
                            {
                                <span class="badge bg-success">Activo</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Inactivo</span>
                            }
                        </div>
                        <div class="form-text">
                            El estado no puede modificarse desde Mi Perfil.
                        </div>
                    </div>

                    <hr />

                    <button type="submit" class="btn btn-primary">
                        Guardar Cambios
                    </button>

                    <a asp-controller="Usuario"
                       asp-action="Perfil"
                       class="btn btn-secondary">
                        Volver a Mi Perfil
                    </a>

                </form>

            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

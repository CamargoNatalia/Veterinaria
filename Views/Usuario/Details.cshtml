@model Veterinaria.Models.Usuario

@{
    ViewData["Title"] = "Detalles del Usuario";
}

<h1>Detalles del Usuario</h1>

<hr />

<div>
    <dl class="row">

        <dt class="col-sm-3">
            @Html.DisplayNameFor(model => model.Nombre)
        </dt>
        <dd class="col-sm-9">
            @Html.DisplayFor(model => model.Nombre)
        </dd>

        <dt class="col-sm-3">
            @Html.DisplayNameFor(model => model.Email)
        </dt>
        <dd class="col-sm-9">
            @Html.DisplayFor(model => model.Email)
        </dd>

        <dt class="col-sm-3">
            @Html.DisplayNameFor(model => model.Rol)
        </dt>
        <dd class="col-sm-9">
            @Html.DisplayFor(model => model.Rol)
        </dd>

        <dt class="col-sm-3">
            @Html.DisplayNameFor(model => model.Avatar)
        </dt>
        <dd class="col-sm-9">
            @if (!string.IsNullOrEmpty(Model.Avatar))
            {
                @Model.Avatar
            }
            else
            {
                <span>Sin avatar</span>
            }
        </dd>

        <dt class="col-sm-3">
            @Html.DisplayNameFor(model => model.Activo)
        </dt>
        <dd class="col-sm-9">
            @(Model.Activo ? "Activo" : "Inactivo")
        </dd>

    </dl>
</div>

<div class="mt-3">
    <a asp-action="Edit"
       asp-route-id="@Model.IdUsuario"
       class="btn btn-warning">
        Editar
    </a>

    <a asp-action="Index"
       class="btn btn-secondary">
        Volver
    </a>
</div>
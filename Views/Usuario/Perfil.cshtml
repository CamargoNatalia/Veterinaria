
@model Veterinaria.Models.Usuario

@{
    ViewData["Title"] = "Mi Perfil";
}

<h2>Mi Perfil</h2>

@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mt-3" role="alert">
        @TempData["Mensaje"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show mt-3" role="alert">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card mt-3">
    <div class="card-header">
        <strong>Datos del Usuario</strong>
    </div>

    <div class="card-body">
        <div class="row align-items-center">

            <div class="col-md-3 text-center mb-4 mb-md-0">

                @if (!string.IsNullOrWhiteSpace(Model.Avatar))
                {
                    <img src="@Model.Avatar"
                         alt="Avatar"
                         class="rounded-circle border shadow-sm"
                         style="width:160px;height:160px;object-fit:cover;" />
                }
                else
                {
                    <div class="rounded-circle bg-secondary text-white d-flex align-items-center justify-content-center mx-auto shadow-sm"
                         style="width:160px;height:160px;font-size:60px;font-weight:bold;">
                        @(string.IsNullOrWhiteSpace(Model.Nombre)
                            ? "U"
                            : Model.Nombre.Substring(0, 1).ToUpper())
                    </div>
                }

                <div class="mt-3">
                    <form asp-controller="Usuario"
                          asp-action="ActualizarAvatar"
                          method="post"
                          enctype="multipart/form-data">

                        @Html.AntiForgeryToken()

                        <div class="mb-2">
                            <input type="file"
                                   name="avatar"
                                   class="form-control form-control-sm"
                                   accept=".jpg,.jpeg,.png,.webp"
                                   required />
                        </div>

                        <button type="submit" class="btn btn-outline-primary btn-sm">
                            Cambiar Avatar
                        </button>
                    </form>

                    <div class="form-text mt-2">
                        JPG, JPEG, PNG o WEBP.
                        Máximo 5 MB.
                    </div>
                </div>
            </div>

            <div class="col-md-9">
                <div class="row">

                    <div class="col-md-6">
                        <p>
                            <strong>Nombre</strong>
                            <span class="d-block">@Model.Nombre</span>
                        </p>

                        <p>
                            <strong>Email</strong>
                            <span class="d-block">@Model.Email</span>
                        </p>
                    </div>

                    <div class="col-md-6">
                        <p>
                            <strong>Rol</strong>
                            <span class="d-block">
                                <span class="badge bg-primary">@Model.Rol</span>
                            </span>
                        </p>

                        <p>
                            <strong>Estado</strong>
                            <span class="d-block">
                                @if (Model.Activo)
                                {
                                    <span class="badge bg-success">Activo</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">Inactivo</span>
                                }
                            </span>
                        </p>
                    </div>

                </div>
            </div>

        </div>
    </div>
</div>

<div class="mt-3">
    <a asp-controller="Usuario"
       asp-action="EditarPerfil"
       class="btn btn-primary">
        Editar Mis Datos
    </a>

    <a asp-controller="Usuario"
       asp-action="CambiarPassword"
       class="btn btn-warning">
        Cambiar Contraseña
    </a>

    <a asp-controller="Home"
       asp-action="Index"
       class="btn btn-secondary">
        Volver
    </a>
</div>

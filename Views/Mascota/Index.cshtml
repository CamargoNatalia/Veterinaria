
@model IEnumerable<Veterinaria.Models.Mascota>

@{
    ViewData["Title"] = "Mascotas";

    bool puedeAdministrar =
        User.IsInRole("Administrador") ||
        User.IsInRole("Empleado");

    int paginaActual = ViewBag.PaginaActual ?? 1;
    int totalPaginas = ViewBag.TotalPaginas ?? 0;
    int totalRegistros = ViewBag.TotalRegistros ?? 0;
}

<h1>Gestión de Mascotas</h1>

<hr />

@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success">
        @TempData["Mensaje"]
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        @TempData["Error"]
    </div>
}

@if (puedeAdministrar)
{
    <div class="mb-3">
        <a asp-action="Create" class="btn btn-primary">
            Nueva Mascota
        </a>
    </div>
}

<div class="table-responsive">
    <table class="table table-striped table-bordered align-middle">

        <thead class="table-dark">
            <tr>
                <th>Nombre</th>
                <th>Especie</th>
                <th>Raza</th>
                <th>Dueño</th>
                <th>Fecha de nacimiento</th>
                <th>Sexo</th>
                <th>Peso</th>
                <th>Estado</th>
                <th>Acciones</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var mascota in Model)
            {
                <tr>
                    <td>@mascota.Nombre</td>
                    <td>@(mascota.Especie?.Nombre ?? "-")</td>
                    <td>@(mascota.Raza?.Nombre ?? "-")</td>

                    <td>
                        @if (mascota.Cliente != null)
                        {
                            @($"{mascota.Cliente.Nombre} {mascota.Cliente.Apellido}")
                        }
                        else
                        {
                            <span class="text-muted">
                                Sin propietario
                            </span>
                        }
                    </td>

                    <td>
                        @(mascota.FechaNacimiento?.ToString("dd/MM/yyyy") ?? "-")
                    </td>

                    <td>@(mascota.Sexo ?? "-")</td>

                    <td>
                        @(mascota.Peso?.ToString("0.##") ?? "-")
                    </td>

                    <td>
                        @if (mascota.Activo)
                        {
                            <span class="badge bg-success">
                                Activa
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">
                                Inactiva
                            </span>
                        }
                    </td>

                    <td>
                        <div class="d-flex gap-1 flex-wrap">

                            <a asp-action="Details"
                               asp-route-id="@mascota.IdMascota"
                               class="btn btn-info btn-sm">
                                Ver
                            </a>

                            <a asp-action="HistoriaClinica"
                               asp-route-id="@mascota.IdMascota"
                               class="btn btn-success btn-sm">
                                Historia Clínica
                            </a>

                            @if (puedeAdministrar)
                            {
                                <a asp-action="Edit"
                                   asp-route-id="@mascota.IdMascota"
                                   class="btn btn-warning btn-sm">
                                    Editar
                                </a>

                                <a asp-action="Delete"
                                   asp-route-id="@mascota.IdMascota"
                                   class="btn btn-danger btn-sm">
                                    Eliminar
                                </a>
                            }

                        </div>
                    </td>
                </tr>
            }

            @if (!Model.Any())
            {
                <tr>
                    <td colspan="9"
                        class="text-center text-muted">
                        No hay mascotas registradas.
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<!-- Paginación -->
<div class="d-flex justify-content-between
            align-items-center flex-wrap gap-2 mt-3">

    <span class="text-muted">
        Total de mascotas: @totalRegistros
    </span>

    <div class="d-flex align-items-center gap-2">

        @if (paginaActual > 1)
        {
            <a asp-action="Index"
               asp-route-pagina="@(paginaActual - 1)"
               class="btn btn-outline-primary btn-sm">
                Anterior
            </a>
        }
        else
        {
            <button class="btn btn-outline-secondary btn-sm"
                    disabled>
                Anterior
            </button>
        }

        <span>
            Página @(totalPaginas == 0 ? 0 : paginaActual)
            de @totalPaginas
        </span>

        @if (paginaActual < totalPaginas)
        {
            <a asp-action="Index"
               asp-route-pagina="@(paginaActual + 1)"
               class="btn btn-outline-primary btn-sm">
                Siguiente
            </a>
        }
        else
        {
            <button class="btn btn-outline-secondary btn-sm"
                    disabled>
                Siguiente
            </button>
        }

    </div>
</div>

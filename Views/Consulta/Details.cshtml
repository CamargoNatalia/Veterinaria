@model Veterinaria.Models.Consulta

@{
    ViewData["Title"] = "Detalles de la Consulta";
}

<h1>Detalles de la Consulta</h1>

<hr />

<!-- DATOS GENERALES -->
<div class="card mb-4">
    <div class="card-header">
        <h5 class="mb-0">Información de la Atención</h5>
    </div>

    <div class="card-body">
        <dl class="row">

            <dt class="col-sm-3">N° de Consulta</dt>
            <dd class="col-sm-9">@Model.IdConsulta</dd>

            <dt class="col-sm-3">Fecha y Hora</dt>
            <dd class="col-sm-9">
                @Model.FechaHora.ToString("dd/MM/yyyy HH:mm")
            </dd>

            <dt class="col-sm-3">Mascota</dt>
            <dd class="col-sm-9">
                @Model.Mascota?.Nombre
            </dd>

            <dt class="col-sm-3">Turno asociado</dt>
            <dd class="col-sm-9">
                @if (Model.IdTurno.HasValue)
                {
                    <a asp-controller="Turno" asp-action="Details" asp-route-id="@Model.IdTurno">
                        Turno N° @Model.IdTurno
                    </a>
                }
                else
                {
                    <span class="text-muted">
                        Consulta directa (sin turno)
                    </span>
                }
            </dd>

            <dt class="col-sm-3">Veterinario responsable</dt>
            <dd class="col-sm-9">
                @if (Model.Veterinario?.Usuario != null)
                {
                    <span>
                        @Model.Veterinario.Usuario.Nombre
                    </span>

                    <span class="text-muted">
                        - Matrícula: @Model.Veterinario.Matricula
                    </span>
                }
                else
                {
                    <span class="text-muted">
                        Sin asignar
                    </span>
                }
            </dd>
            <dt class="col-sm-3">Registrado por</dt>
            <dd class="col-sm-9">
                @Model.Usuario?.Nombre
            </dd>

        </dl>
    </div>
</div>

<!-- DATOS CLÍNICOS -->
<div class="card mb-4">
    <div class="card-header">
        <h5 class="mb-0">Datos Clínicos</h5>
    </div>

    <div class="card-body">
        <dl class="row">

            <dt class="col-sm-3">Motivo</dt>
            <dd class="col-sm-9">
                @(Model.Motivo ?? "Sin registrar")
            </dd>

            <dt class="col-sm-3">Diagnóstico</dt>
            <dd class="col-sm-9">
                @(Model.Diagnostico ?? "Sin registrar")
            </dd>

            <dt class="col-sm-3">Tratamiento</dt>
            <dd class="col-sm-9">
                @(Model.Tratamiento ?? "Sin registrar")
            </dd>

            <dt class="col-sm-3">Observaciones</dt>
            <dd class="col-sm-9">
                @(Model.Observaciones ?? "Sin registrar")
            </dd>

        </dl>
    </div>
</div>

<!-- HISTORIA CLÍNICA -->
<div class="card mb-4">
    <div class="card-header">
        <h5 class="mb-0">Archivos de Historia Clínica</h5>
    </div>

    <div class="card-body">

        @if (Model.HistoriasClinicas != null &&
             Model.HistoriasClinicas.Any())
        {
            <div class="table-responsive">
                <table class="table table-striped align-middle">
                    <thead>
                        <tr>
                            <th>Archivo</th>
                            <th>Formato</th>
                            <th>Fecha de Carga</th>
                            <th>Descripción</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var archivo in Model.HistoriasClinicas)
                        {
                            <tr>
                                <td>@archivo.NombreArchivo</td>

                                <td>@archivo.FormatoArchivo</td>

                                <td>
                                    @archivo.CargaArchivo.ToString(
                                        "dd/MM/yyyy HH:mm")
                                </td>

                                <td>
                                    @(archivo.Descripcion ?? "-")
                                </td>

                                <td>
                                    <div class="d-flex gap-2">

                                        <a asp-controller="HClinica" asp-action="Ver" asp-route-id="@archivo.IdHClinica"
                                           class="btn btn-primary btn-sm" target="_blank" rel="noopener noreferrer">
                                            Ver
                                        </a>

                                        <a asp-controller="HClinica" asp-action="Descargar" asp-route-id="@archivo.IdHClinica"
                                           class="btn btn-success btn-sm">
                                            Descargar
                                        </a>

                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <p class="text-muted mb-3">
                Esta consulta todavía no tiene archivos clínicos asociados.
            </p>
        }

        <div class="mt-3">
            <a asp-controller="HClinica" asp-action="Create" asp-route-idConsulta="@Model.IdConsulta"
               class="btn btn-success">
                Adjuntar Archivo Clínico
            </a>
        </div>

    </div>
</div>

<!-- ACCIONES -->
<div class="mb-4">
    <a asp-action="Edit" asp-route-id="@Model.IdConsulta" class="btn btn-warning">
        Editar Consulta
    </a>

    <a asp-action="Index" class="btn btn-secondary">
        Volver
    </a>
</div>
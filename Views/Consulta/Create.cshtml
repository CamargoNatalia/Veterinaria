
@model Veterinaria.Models.Consulta
@using Veterinaria.Models

@{
    ViewData["Title"] = "Nueva Consulta";

    var turno = ViewBag.TurnoSeleccionado as Turno;
    bool tieneTurno = Model.IdTurno.HasValue;
}

<h1>Nueva Consulta</h1>
<hr />

@if (tieneTurno)
{
    <div class="alert alert-info">
        <h5>Atención desde un turno</h5>

        <p class="mb-1">
            <strong>Turno N.º:</strong> @Model.IdTurno
        </p>

        @if (turno != null)
        {
            <p class="mb-1">
                <strong>Fecha programada:</strong>
                @turno.FechaHora.ToString("dd/MM/yyyy HH:mm")
            </p>

            <p class="mb-0">
                <strong>Estado:</strong> @turno.Estado
            </p>
        }
    </div>
}
else
{
    <div class="alert alert-secondary">
        Consulta directa, sin turno previo.
    </div>
}

<form asp-action="Create" method="post" id="formConsulta">

    @Html.AntiForgeryToken()

    <div asp-validation-summary="ModelOnly"
         class="text-danger mb-3"></div>

    <input type="hidden" asp-for="IdTurno" />
    <span asp-validation-for="IdTurno" class="text-danger"></span>

    <!-- MASCOTA -->

    <div class="card mb-4">
        <div class="card-header">
            <h5 class="mb-0">Datos de la mascota</h5>
        </div>

        <div class="card-body">

            <div class="mb-3">
                <label for="buscarMascota" class="form-label">
                    Seleccionar Mascota
                </label>

                <input type="text"
                       id="buscarMascota"
                       class="form-control"
                       value="@ViewBag.MascotaSeleccionada"
                       placeholder="Buscar mascota o propietario..."
                       autocomplete="off"
                       readonly="@tieneTurno" />

                <input type="hidden" asp-for="IdMascota" />

                @if (!tieneTurno)
                {
                    <div id="resultadosMascotas"
                         class="list-group mt-1"></div>

                    <div id="avisoMascota" class="form-text">
                        Escribí al menos 2 caracteres y seleccioná una mascota.
                    </div>
                }
                else
                {
                    <div class="form-text">
                        Mascota asociada al turno. No se puede cambiar.
                    </div>
                }

                <span asp-validation-for="IdMascota"
                      class="text-danger"></span>
            </div>

            <div id="fichaMascota"
                 class="row g-3"
                 style="display:none;">

                <div class="col-md-4">
                    <strong>Nombre:</strong>
                    <div id="mascotaNombre"></div>
                </div>

                <div class="col-md-4">
                    <strong>Especie:</strong>
                    <div id="mascotaEspecie"></div>
                </div>

                <div class="col-md-4">
                    <strong>Raza:</strong>
                    <div id="mascotaRaza"></div>
                </div>

                <div class="col-md-4">
                    <strong>Sexo:</strong>
                    <div id="mascotaSexo"></div>
                </div>

                <div class="col-md-4">
                    <strong>Fecha de nacimiento:</strong>
                    <div id="mascotaNacimiento"></div>
                </div>

                <div class="col-md-4">
                    <strong>Peso:</strong>
                    <div id="mascotaPeso"></div>
                </div>

                <div class="col-12">
                    <strong>Observaciones:</strong>
                    <div id="mascotaObservaciones"></div>
                </div>
            </div>

            <div id="errorFicha"
                 class="alert alert-warning mt-3"
                 style="display:none;">
                No se pudieron recuperar los datos de la mascota.
            </div>

        </div>
    </div>

    <!-- PROPIETARIO -->

    <div class="card mb-4"
         id="fichaPropietario"
         style="display:none;">

        <div class="card-header">
            <h5 class="mb-0">Datos del propietario</h5>
        </div>

        <div class="card-body">
            <div class="row g-3">

                <div class="col-md-6">
                    <strong>Nombre y Apellido:</strong>
                    <div id="propietarioNombre"></div>
                </div>

                <div class="col-md-6">
                    <strong>DNI:</strong>
                    <div id="propietarioDni"></div>
                </div>

                <div class="col-md-6">
                    <strong>Teléfono:</strong>
                    <div id="propietarioTelefono"></div>
                </div>

                <div class="col-md-6">
                    <strong>Correo:</strong>
                    <div id="propietarioCorreo"></div>
                </div>

                <div class="col-12">
                    <strong>Dirección:</strong>
                    <div id="propietarioDireccion"></div>
                </div>

            </div>
        </div>
    </div>

    <!-- VETERINARIO -->

    <div class="card mb-4">
        <div class="card-header">
            <h5 class="mb-0">Profesional responsable</h5>
        </div>

        <div class="card-body">

            @if (User.IsInRole("Veterinario"))
            {
                <div class="mb-3">
                    <label class="form-label">Veterinario</label>

                    <input type="text"
                           class="form-control"
                           value="@User.Identity?.Name"
                           readonly />

                    <div class="form-text">
                        El profesional se asigna automáticamente
                        según la sesión iniciada.
                    </div>

                    <span asp-validation-for="IdVeterinario"
                          class="text-danger"></span>
                </div>
            }
            else
            {
                <div class="mb-3">
                    <label asp-for="IdVeterinario"
                           class="form-label">
                        Veterinario
                    </label>

                    <select asp-for="IdVeterinario"
                            asp-items="ViewBag.Veterinarios"
                            class="form-select"
                            required>
                        <option value="">
                            -- Seleccione un veterinario --
                        </option>
                    </select>

                    <span asp-validation-for="IdVeterinario"
                          class="text-danger"></span>
                </div>
            }

        </div>
    </div>

    <!-- DATOS CLÍNICOS -->

    <div class="card mb-4">
        <div class="card-header">
            <h5 class="mb-0">Datos de la consulta</h5>
        </div>

        <div class="card-body">

            <div class="mb-3">
                <label asp-for="FechaHora" class="form-label">
                    Fecha y Hora de Atención
                </label>

                <input asp-for="FechaHora"
                       type="datetime-local"
                       asp-format="{0:yyyy-MM-ddTHH:mm}"
                       class="form-control" />

                <span asp-validation-for="FechaHora"
                      class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Motivo" class="form-label">
                    Motivo de Consulta
                </label>

                <textarea asp-for="Motivo"
                          class="form-control"
                          rows="3"
                          maxlength="1000"></textarea>

                <span asp-validation-for="Motivo"
                      class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Diagnostico" class="form-label">
                    Diagnóstico
                </label>

                <textarea asp-for="Diagnostico"
                          class="form-control"
                          rows="3"
                          maxlength="2000"></textarea>

                <span asp-validation-for="Diagnostico"
                      class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Tratamiento" class="form-label">
                    Tratamiento
                </label>

                <textarea asp-for="Tratamiento"
                          class="form-control"
                          rows="3"
                          maxlength="2000"></textarea>

                <span asp-validation-for="Tratamiento"
                      class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Observaciones" class="form-label">
                    Observaciones
                </label>

                <textarea asp-for="Observaciones"
                          class="form-control"
                          rows="3"
                          maxlength="2000"></textarea>

                <span asp-validation-for="Observaciones"
                      class="text-danger"></span>
            </div>
        </div>
    </div>

    <!-- BOTONES -->

    <div class="mb-4 d-flex gap-2 flex-wrap">

        <button type="submit"
                name="accion"
                value="guardar"
                class="btn btn-primary">
            Guardar Consulta
        </button>

        <button type="submit"
                name="accion"
                value="reservarTurno"
                class="btn btn-success">
            Guardar Consulta y Reservar Próximo Turno
        </button>

        <a asp-action="Index" class="btn btn-secondary">
            Volver
        </a>
    </div>

</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const buscador = document.getElementById("buscarMascota");
            const selector = document.getElementById("IdMascota");
            const resultados = document.getElementById("resultadosMascotas");
            const aviso = document.getElementById("avisoMascota");
            const fichaMascota = document.getElementById("fichaMascota");
            const fichaPropietario = document.getElementById("fichaPropietario");
            const errorFicha = document.getElementById("errorFicha");

            const urlBuscar = '@Url.Action("BuscarMascotas", "Turno")';
            const urlDatos = '@Url.Action("ObtenerDatosMascota", "Consulta")';

            let temporizador;
            let solicitudActual = 0;
            let solicitudFicha = 0;

            function mostrar(id, valor) {
                document.getElementById(id).textContent =
                    valor === null || valor === undefined || valor === ""
                        ? "No registrado"
                        : valor;
            }

            function ocultarFichas() {
                fichaMascota.style.display = "none";
                fichaPropietario.style.display = "none";
                errorFicha.style.display = "none";
            }

            async function cargarFicha() {
                const id = selector.value;
                const numeroSolicitud = ++solicitudFicha;

                ocultarFichas();

                if (!id || Number(id) <= 0)
                    return;

                try {
                    const respuesta = await fetch(
                        urlDatos + "?id=" + encodeURIComponent(id),
                        { credentials: "same-origin" }
                    );

                    if (!respuesta.ok)
                        throw new Error("Error");

                    const mascota = await respuesta.json();

                    if (numeroSolicitud !== solicitudFicha)
                        return;

                    mostrar("mascotaNombre", mascota.nombre);
                    mostrar("mascotaEspecie", mascota.especie);
                    mostrar("mascotaRaza", mascota.raza);
                    mostrar("mascotaSexo", mascota.sexo);

                    const nacimiento = mascota.fechaNacimiento
                        ? new Date(mascota.fechaNacimiento)
                            .toLocaleDateString("es-AR", {
                                timeZone: "UTC"
                            })
                        : null;

                    mostrar("mascotaNacimiento", nacimiento);

                    mostrar(
                        "mascotaPeso",
                        mascota.peso != null
                            ? mascota.peso + " kg"
                            : null
                    );

                    mostrar(
                        "mascotaObservaciones",
                        mascota.observaciones
                    );

                    fichaMascota.style.display = "";

                    if (mascota.propietario) {
                        mostrar(
                            "propietarioNombre",
                            mascota.propietario.nombreCompleto
                        );
                        mostrar(
                            "propietarioDni",
                            mascota.propietario.dni
                        );
                        mostrar(
                            "propietarioTelefono",
                            mascota.propietario.telefono
                        );
                        mostrar(
                            "propietarioCorreo",
                            mascota.propietario.correo
                        );
                        mostrar(
                            "propietarioDireccion",
                            mascota.propietario.direccion
                        );

                        fichaPropietario.style.display = "";
                    }

                } catch (error) {
                    if (numeroSolicitud === solicitudFicha)
                        errorFicha.style.display = "";
                }
            }

            if (!buscador.readOnly) {
                buscador.addEventListener("input", function () {

                    const texto = buscador.value.trim();
                    const numeroSolicitud = ++solicitudActual;

                    clearTimeout(temporizador);
                    selector.value = "";
                    resultados.replaceChildren();
                    ocultarFichas();
                    ++solicitudFicha;

                    if (texto.length < 2) {
                        aviso.textContent = "Escribí al menos 2 caracteres.";
                        return;
                    }

                    aviso.textContent = "Buscando mascotas...";

                    temporizador = setTimeout(async function () {
                        try {
                            const respuesta = await fetch(
                                urlBuscar + "?termino=" +
                                encodeURIComponent(texto),
                                { credentials: "same-origin" }
                            );

                            if (!respuesta.ok)
                                throw new Error("Error");

                            const mascotas = await respuesta.json();

                            if (numeroSolicitud !== solicitudActual)
                                return;

                            resultados.replaceChildren();

                            if (mascotas.length === 0) {
                                aviso.textContent =
                                    "No se encontraron mascotas activas.";
                                return;
                            }

                            aviso.textContent =
                                "Elegí una mascota de la lista.";

                            mascotas.forEach(function (mascota) {
                                const descripcion =
                                    mascota.nombre + " - " +
                                    mascota.propietario + " - " +
                                    mascota.especie + " - " +
                                    mascota.raza;

                                const boton =
                                    document.createElement("button");

                                boton.type = "button";
                                boton.className =
                                    "list-group-item list-group-item-action";
                                boton.textContent = descripcion;

                                boton.addEventListener("click", function () {
                                    ++solicitudActual;
                                    clearTimeout(temporizador);

                                    selector.value = mascota.idMascota;
                                    buscador.value = descripcion;
                                    resultados.replaceChildren();

                                    aviso.textContent =
                                        "Mascota seleccionada correctamente.";

                                    cargarFicha();
                                });

                                resultados.appendChild(boton);
                            });

                        } catch (error) {
                            if (numeroSolicitud === solicitudActual) {
                                resultados.replaceChildren();
                                aviso.textContent =
                                    "No se pudo realizar la búsqueda.";
                            }
                        }
                    }, 300);
                });
            }

            document.getElementById("formConsulta")
                .addEventListener("submit", function (e) {
                    if (!selector.value ||
                        Number(selector.value) <= 0) {
                        e.preventDefault();

                        if (aviso) {
                            aviso.textContent =
                                "Tenés que seleccionar una mascota.";
                        }

                        buscador.focus();
                    }
                });

            // Cargar ficha cuando la consulta proviene de un turno
            if (selector.value && Number(selector.value) > 0) {
                cargarFicha();
            }
        });
    </script>
}

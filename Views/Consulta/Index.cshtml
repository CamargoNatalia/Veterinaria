
@model IEnumerable<Veterinaria.Models.Consulta>
@using Veterinaria.Models

@{
    ViewData["Title"] = "Consultas";

    var turnosPendientes = ViewBag.TurnosPendientes as IEnumerable<Turno>
        ?? Enumerable.Empty<Turno>();

    int paginaConsultas = ViewBag.PaginaConsultas ?? 1;
    int totalPaginasConsultas = ViewBag.TotalPaginasConsultas ?? 0;
    int totalConsultas = ViewBag.TotalConsultas ?? 0;

    int paginaTurnos = ViewBag.PaginaTurnos ?? 1;
    int totalPaginasTurnos = ViewBag.TotalPaginasTurnos ?? 0;
    int totalTurnos = ViewBag.TotalTurnosPendientes ?? 0;

    var ahora = DateTime.Now;
}

<h1>Gestión de Consultas</h1>
<hr />

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success">@TempData["Mensaje"]</div>
}

<div class="mb-4">
    <a asp-action="Create" class="btn btn-primary">
        Nueva Consulta (sin turno)
    </a>
</div>

<!-- TURNOS PENDIENTES -->

<h3 id="turnos">Turnos pendientes de atención</h3>

<p class="text-muted">
    Turnos que todavía no fueron atendidos,
    independientemente de su fecha programada.
</p>

<div class="table-responsive mb-3">
    <table class="table table-striped table-bordered align-middle">
        <thead class="table-dark">
            <tr>
                <th>Fecha y Hora</th>
                <th>Mascota</th>
                <th>Motivo</th>
                <th>Estado</th>
                <th>Situación</th>
                <th>Acciones</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var turno in turnosPendientes)
            {
                var situacion = turno.FechaHora.Date < ahora.Date
                    ? "Vencido"
                    : turno.FechaHora.Date == ahora.Date
                        ? "Hoy"
                        : "Próximo";

                <tr>
                    <td>@turno.FechaHora.ToString("dd/MM/yyyy HH:mm")</td>
                    <td>@(turno.Mascota?.Nombre ?? "-")</td>
                    <td>@turno.Motivo</td>
                    <td>
                        <span class="badge bg-warning text-dark">
                            @turno.Estado
                        </span>
                    </td>

                    <td>
                        @if (situacion == "Vencido")
                        {
                            <span class="badge bg-danger">Vencido</span>
                        }
                        else if (situacion == "Hoy")
                        {
                            <span class="badge bg-info text-dark">Hoy</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Próximo</span>
                        }
                    </td>

                    <td>
                        <div class="d-flex gap-1 flex-wrap">
                            <a asp-controller="Turno"
                               asp-action="Details"
                               asp-route-id="@turno.IdTurno"
                               class="btn btn-info btn-sm">
                                Detalles
                            </a>

                            <a asp-controller="Consulta"
                               asp-action="Create"
                               asp-route-idTurno="@turno.IdTurno"
                               class="btn btn-success btn-sm">
                                Atender
                            </a>
                        </div>
                    </td>
                </tr>
            }

            @if (!turnosPendientes.Any())
            {
                <tr>
                    <td colspan="6" class="text-center text-muted">
                        No hay turnos pendientes de atención.
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<!-- PAGINACIÓN DE TURNOS -->

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-5">

    <span class="text-muted">
        Total de turnos pendientes: @totalTurnos
    </span>

    <div class="d-flex align-items-center gap-2">
        @if (paginaTurnos > 1)
        {
            <a asp-action="Index"
               asp-route-paginaTurnos="@(paginaTurnos - 1)"
               asp-route-paginaConsultas="@paginaConsultas"
               asp-fragment="turnos"
               class="btn btn-outline-primary btn-sm">
                Anterior
            </a>
        }
        else
        {
            <button class="btn btn-outline-secondary btn-sm" disabled>
                Anterior
            </button>
        }

        <span>
            Página @(totalPaginasTurnos == 0 ? 0 : paginaTurnos)
            de @totalPaginasTurnos
        </span>

        @if (paginaTurnos < totalPaginasTurnos)
        {
            <a asp-action="Index"
               asp-route-paginaTurnos="@(paginaTurnos + 1)"
               asp-route-paginaConsultas="@paginaConsultas"
               asp-fragment="turnos"
               class="btn btn-outline-primary btn-sm">
                Siguiente
            </a>
        }
        else
        {
            <button class="btn btn-outline-secondary btn-sm" disabled>
                Siguiente
            </button>
        }
    </div>
</div>

<!-- CONSULTAS REALIZADAS -->

<h3 id="consultas">Consultas realizadas</h3>

<p class="text-muted">
    Historial de atenciones registradas en la veterinaria.
</p>

<div class="table-responsive mb-3">
    <table class="table table-striped table-bordered align-middle">
        <thead class="table-dark">
            <tr>
                <th>Fecha y Hora</th>
                <th>Mascota</th>
                <th>Veterinario</th>
                <th>Usuario</th>
                <th>Motivo</th>
                <th>Diagnóstico</th>
                <th>Tratamiento</th>
                <th>Acciones</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var consulta in Model)
            {
                <tr>
                    <td>
                        @consulta.FechaHora.ToString("dd/MM/yyyy HH:mm")
                    </td>

                    <td>@(consulta.Mascota?.Nombre ?? "-")</td>

                    <td>
                        @(consulta.Veterinario?.Usuario?.Nombre ?? "Sin asignar")
                    </td>

                    <td>@(consulta.Usuario?.Nombre ?? "-")</td>

                    <td>@consulta.Motivo</td>
                    <td>@consulta.Diagnostico</td>
                    <td>@consulta.Tratamiento</td>

                    <td>
                        <div class="d-flex gap-1 flex-wrap">

                            <a asp-action="Details"
                               asp-route-id="@consulta.IdConsulta"
                               class="btn btn-info btn-sm">
                                Ver
                            </a>

                            <a asp-action="Edit"
                               asp-route-id="@consulta.IdConsulta"
                               class="btn btn-warning btn-sm">
                                Editar
                            </a>

                            @if (User.IsInRole("Administrador"))
                            {
                                <a asp-action="Delete"
                                   asp-route-id="@consulta.IdConsulta"
                                   class="btn btn-danger btn-sm">
                                    Eliminar
                                </a>
                            }
                        </div>
                    </td>
                </tr>
            }

            @if (!Model.Any())
            {
                <tr>
                    <td colspan="8" class="text-center text-muted">
                        Todavía no hay consultas registradas.
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<!-- PAGINACIÓN DE CONSULTAS -->

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mt-3">

    <span class="text-muted">
        Total de consultas: @totalConsultas
    </span>

    <div class="d-flex align-items-center gap-2">

        @if (paginaConsultas > 1)
        {
            <a asp-action="Index"
               asp-route-paginaConsultas="@(paginaConsultas - 1)"
               asp-route-paginaTurnos="@paginaTurnos"
               asp-fragment="consultas"
               class="btn btn-outline-primary btn-sm">
                Anterior
            </a>
        }
        else
        {
            <button class="btn btn-outline-secondary btn-sm" disabled>
                Anterior
            </button>
        }

        <span>
            Página @(totalPaginasConsultas == 0 ? 0 : paginaConsultas)
            de @totalPaginasConsultas
        </span>

        @if (paginaConsultas < totalPaginasConsultas)
        {
            <a asp-action="Index"
               asp-route-paginaConsultas="@(paginaConsultas + 1)"
               asp-route-paginaTurnos="@paginaTurnos"
               asp-fragment="consultas"
               class="btn btn-outline-primary btn-sm">
                Siguiente
            </a>
        }
        else
        {
            <button class="btn btn-outline-secondary btn-sm" disabled>
                Siguiente
            </button>
        }
    </div>
</div>
